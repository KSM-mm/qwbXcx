{
  "pages": [
    "pages/home/index",
    "pages/search/index",
    "pages/expiry/index",
    "pages/list/index"
  ],
  "lazyCodeLoading": "requiredComponents",
  "subpackages": [
    {
      "root": "pages/login",
      "name": "login",
      "pages": ["login"]
    },
    {
      "root": "pages/family",
      "name": "family",
      "pages": ["index", "create"]
    },
    {
      "root": "pages/space",
      "name": "space",
      "pages": ["index", "form"]
    },
    {
      "root": "pages/scan",
      "name": "scan",
      "pages": ["index", "confirm"]
    },
    {
      "root": "pages/voice",
      "name": "voice",
      "pages": ["index"]
    },
    {
      "root": "pages/item",
      "name": "item",
      "pages": ["index", "form"]
    },
    {
      "root": "pages/members",
      "name": "members",
      "pages": ["index"]
    },
    {
      "root": "pages/my",
      "name": "my",
      "pages": ["index", "info-edit/index"]
    },
    {
      "root": "pages/chat",
      "name": "chat",
      "pages": ["index"]
    },
    {
      "root": "pages/loginCode",
      "name": "loginCode",
      "pages": ["loginCode"]
    },
    {
      "root": "pages/dataCenter",
      "name": "dataCenter",
      "pages": ["index"]
    },
    {
      "root": "pages/setting",
      "name": "setting",
      "pages": ["index"]
    },
    {
      "root": "pages/release",
      "name": "release",
      "pages": ["index"]
    }
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#f8f6ef",
    "navigationBarTitleText": "栖物簿",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f8f6ef"
  },
  "tabBar": {
    "custom": true,
    "color": "#87958d",
    "selectedColor": "#3d7850",
    "backgroundColor": "#fffefa",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/search/index",
        "text": "搜索"
      },
      {
        "pagePath": "pages/expiry/index",
        "text": "临期"
      },
      {
        "pagePath": "pages/list/index",
        "text": "清单"
      }
    ]
  },
  "resolveAlias": {
    "~/*": "/*"
  },
  "sitemapLocation": "sitemap.json"
}
