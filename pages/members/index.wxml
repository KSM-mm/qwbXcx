<view class="q-page members">
  <q-header title="成员与权限" />
  <q-guide text="家庭角色只作用于家庭共享空间；个人空间由所有者决定是否向指定家庭成员开放只读权限。" />
  <view class="members__note">
    <view class="members__note-icon">
      <q-icon name="lock" size="40" color="#73578a" />
    </view>
    <view>
      <view class="members__note-title">关于私人空间</view>
      <view class="members__note-desc">个人空间默认仅所有者可见；所有者可以选择一名或多名家庭成员只读查看。</view>
    </view>
  </view>

  <view class="members__section">
    <view class="members__title">家庭成员</view>
    <view class="members__row" wx:for="{{members}}" wx:key="name">
      <view class="members__avatar" style="background: {{item.color}}">{{item.initials}}</view>
      <view class="members__body">
        <view class="members__name">
          {{item.name}}
          <text wx:if="{{item.self}}" class="members__me">（我）</text>
        </view>
        <q-pill text="{{item.role}}" tone="{{item.tone}}" />
      </view>
      <q-icon name="chevron" size="34" color="#829188" />
    </view>
    <view class="members__invite" bindtap="onInvite">
      <q-icon name="plus" size="34" color="#4b8559" />
      邀请新成员
    </view>

    <view class="members__title members__title--mt">权限说明</view>
    <view class="members__role" wx:for="{{roles}}" wx:key="role">
      <view class="members__dot" style="background: {{item.color}}"></view>
      <text class="members__role-name">{{item.role}}</text>
      <text class="members__role-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
